# Neon -> Project -> Connect. Keep this variable SERVER ONLY.
DATABASE_URL=postgresql://user:password@your-project.neon.tech/neondb?sslmode=require
# Random 32+ byte secret used to hash request IPs for privacy-preserving rate limits.
IP_HASH_SECRET=replace-with-a-random-long-secret
# Optional. If omitted, Explore NASJ opens the included local illustrative platform tour.
NEXT_PUBLIC_NASJ_PLATFORM_URL=
