# Neon PostgreSQL Connection (Server-side only)
DATABASE_URL=postgresql://user:password@your-project.neon.tech/neondb?sslmode=require

# Random 32+ byte secret used to hash request IPs for privacy-preserving rate limits.
IP_HASH_SECRET=replace-with-a-random-long-secret-at-least-32-chars

# NASJ Platform Public URL (defaults to https://nasj-platform.ddns.net)
NEXT_PUBLIC_NASJ_PLATFORM_URL=https://nasj-platform.ddns.net
NASJ_PLATFORM_URL=https://nasj-platform.ddns.net

# Email provider: mailjet or resend. Credentials must stay server-side.
EMAIL_PROVIDER=mailjet
MAILJET_API_KEY=replace-with-your-api-key
MAILJET_SECRET_KEY=replace-with-your-secret-key
MAILJET_FROM_EMAIL=info.nasj.app@gmail.com
MAILJET_FROM_NAME="NASJ First Thread"

# ─── Resend (optional alternative provider) ──────────
RESEND_API_KEY=re_your_resend_api_key
# Use onboarding@resend.dev until your custom domain is verified in resend.com/domains
RESEND_FROM_EMAIL="NASJ First Thread <onboarding@resend.dev>"
NASJ_SUPPORT_EMAIL=info.nasj.app@gmail.com

# ─── Resend Webhooks (optional) ─────
# RESEND_WEBHOOK_SECRET=whsec_your_webhook_secret
